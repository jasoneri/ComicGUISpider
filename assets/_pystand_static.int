import importlib
import os
import sys
import shutil
import argparse
import pathlib
import subprocess
from importlib.machinery import SourceFileLoader
from types import ModuleType

VER = "2.11.1"
DEFAULT_INDEX = r'https://pypi.tuna.tsinghua.edu.cn/simple/'


class CGSInstaller:
    def __init__(self):
        self.root = pathlib.Path(__file__).parent
        self.runtime = self.root / 'runtime'
        self.toolbin = self.root / "bin"
        self.toolbin.mkdir(exist_ok=True)
        self.uv = self.runtime / "uv.exe"
        self.installer = self.runtime / "installer.exe"
        self.cgs = self.toolbin / "cgs.exe"
        self.env = self._build_env()
        self.args = None

    def _build_env(self):
        env = os.environ.copy()
        env['UV_TOOL_DIR'] = str(self.root)
        env['UV_TOOL_BIN_DIR'] = str(self.toolbin)
        env['PATH'] = str(self.runtime) + os.pathsep + env.get('PATH', '')
        env['UV_NO_MANAGED_PYTHON'] = '1'
        env['VIRTUAL_ENV'] = str(self.runtime)
        return env

    @staticmethod
    def _split_argv(argv):
        if "--" not in argv:
            return argv, []
        sep = argv.index("--")
        return argv[:sep], argv[sep + 1:]

    @classmethod
    def _parse_args(cls):
        cgs_args, uv_args = cls._split_argv(sys.argv[1:])
        parser = argparse.ArgumentParser(
            description="cgs",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="uv passthrough: append '-- <uv tool install args>' after CGS.exe args.",
        )
        parser.add_argument('-i', '--index', type=str, nargs='?', default=None, help=f'pypi source (default: {DEFAULT_INDEX})')
        parser.add_argument('-v', '--version', type=str, default=None, help='specify ComicGUISpider version to install, e.g. 2.8.0')
        parser.add_argument('-c', '--conf', type=str, default=None, help='uv.toml')
        args = parser.parse_args(cgs_args)
        args.uv_args = uv_args
        return args

    def clean(self):
        for p in (self.toolbin, self.root / "comicguispider"):
            if p.exists() and p.is_dir():
                shutil.rmtree(p)

    def run(self):
        subprocess.Popen([str(self.cgs)], env=self.env, text=True)

    def _build_direct_install_cmd(self, pkg_spec, uv_args):
        if self.args.conf:
            return [
                str(self.uv), "--config-file", str(self.root / self.args.conf),
                "tool", "install", pkg_spec, "--force", "--reinstall",
                *uv_args,
            ]
        return [
            str(self.uv), "tool", "install", pkg_spec, "--force", "--reinstall",
            "--index-url", self.args.index or DEFAULT_INDEX,
            *uv_args,
        ]

    def _build_installer_cmd(self, uv_args):
        cmd = [
            str(self.installer),
            "--cgs-ver", self.args.version,
            "--uv-exc", str(self.uv),
            "--index-url", self.args.index or DEFAULT_INDEX,
            "--uv-tool-dir", str(self.root), "--uv-tool-bin-dir", str(self.toolbin),
        ]
        if uv_args:
            cmd.extend(["--", *uv_args])
        return cmd

    def _build_install_cmd(self):
        # Omitting --version keeps the historical "install latest stable" semantics.
        pkg_spec = "ComicGUISpider" if self.args.version is None else f"ComicGUISpider=={self.args.version}"
        uv_args = list(self.args.uv_args)
        if self.args.version is None or self.args.conf:
            return self._build_direct_install_cmd(pkg_spec, uv_args), False
        if not self.installer.exists():
            raise RuntimeError(f"installer missing: {self.installer}")
        return self._build_installer_cmd(uv_args), True

    def _update_int(self):
        new_int = self.root / "comicguispider/Lib/site-packages/assets/_pystand_static.int"
        if not new_int.exists():
            return
        loader = SourceFileLoader("cgs_new_pystand_static_int", str(new_int))
        new_int_module = ModuleType(loader.name)
        new_int_module.__file__ = str(new_int)
        loader.exec_module(new_int_module)
        new_ver = getattr(new_int_module, "VER", None)
        if new_ver is None:
            return
        site_packages = new_int.parents[1]
        site_packages_str = str(site_packages)
        added_site_packages = site_packages_str not in sys.path
        if added_site_packages:
            sys.path.insert(0, site_packages_str)
        try:
            parse = importlib.import_module("packaging.version").parse
        finally:
            if added_site_packages:
                sys.path.remove(site_packages_str)
        if parse(new_ver) < parse(VER):
            return
        shutil.copy2(new_int, self.root / "_pystand_static.int")

    def install(self):
        self.clean()
        cmd, uses_installer = self._build_install_cmd()
        print(cmd)
        exit_code = subprocess.Popen(cmd, env=self.env, text=True).wait()
        self._update_int()
        if self.cgs.exists():
            if not uses_installer or exit_code != 0:
                self.run()
            return
        self.clean()
        input(r"安装失败，参考换源安装 \n https://cgs.101114105.xyz/faq/#i-%E5%88%9D%E6%AC%A1%E9%83%A8%E7%BD%B2%E6%8D%A2%E6%BA%90 \n按任意键回车退出本程序")

    def main(self):
        # Fast path: no args, cgs exists → skip argparse entirely
        if not sys.argv[1:] and self.cgs.exists():
            return self.run()
        self.args = self._parse_args()
        a = self.args
        if not self.cgs.exists() or a.index is not None or a.version is not None or a.conf or a.uv_args:
            self.install()
        else:
            self.run()


if __name__ == '__main__':
    CGSInstaller().main()
