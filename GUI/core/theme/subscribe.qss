/* ToolWorkspaceWindow QSS — follows qfluent / danbooru day-night token pattern. */

/* @tokens light */
CANVAS = #f5f5f4;
SHELL = rgba(250, 250, 249, 0.98);
SHELL_BORDER = rgba(39, 39, 42, 0.10);
CARD_BG = rgba(255, 255, 255, 0.99);
CARD_BORDER = rgba(39, 39, 42, 0.10);
CARD_HOVER_BORDER = rgba(39, 39, 42, 0.26);
COVER_BG = rgba(39, 39, 42, 0.05);
TEXT = rgba(9, 9, 11, 0.97);
MUTED_TEXT = rgba(63, 63, 70, 0.74);
STATUS_BG = rgba(250, 250, 249, 0.96);
STATUS_BORDER = rgba(39, 39, 42, 0.10);
BADGE_DL_BG = rgba(244, 244, 245, 0.95);
BADGE_DL_TEXT = rgba(63, 63, 70, 0.88);
BADGE_DL_BORDER = rgba(148, 163, 184, 0.28);
BADGE_NEW_BG = rgba(254, 226, 226, 0.96);
BADGE_NEW_TEXT = rgba(185, 28, 28, 0.95);
BADGE_NEW_BORDER = rgba(239, 68, 68, 0.28);
BADGE_OK_BG = rgba(220, 252, 231, 0.96);
BADGE_OK_TEXT = rgba(21, 128, 61, 0.95);
BADGE_OK_BORDER = rgba(34, 197, 94, 0.28);
CARD_SELECTED_BORDER = rgba(37, 99, 235, 0.72);
CARD_SELECTED_BG = rgba(219, 234, 254, 0.55);
CARD_PAUSED_OPACITY = 0.55;
OVERLAY_BTN_BG = rgba(15, 23, 42, 0.28);
OVERLAY_BTN_BG_HOVER = rgba(15, 23, 42, 0.35);
OVERLAY_BTN_BORDER = rgba(255, 255, 255, 0.22);
BTN_DANGER = #E06666;
BTN_DANGER_HOVER = #E57373;
BTN_DANGER_PRESSED = #E89292;
BTN_DANGER_BORDER = #D24F4F;
BTN_DANGER_BORDER_BOTTOM = #B03F3F;
/* @endtokens */

/* 夜间锚点 = SpiderGUI 原生 Dark QPalette.Window (53,53,53)。层级沿用 tray.qss 的亲和中性阶：
   canvas #353535 → shell/status +10 → card +15，ΔL 压在 15 以内，杜绝近黑纯黑割裂感。
   注意：注释不得写进 @tokens 体内（token 解析器逐行要求 KEY = VALUE）。 */
/* @tokens dark */
CANVAS = #353535;
SHELL = #3f3f3f;
SHELL_BORDER = rgba(244, 244, 245, 0.14);
CARD_BG = #454547;
CARD_BORDER = rgba(244, 244, 245, 0.14);
CARD_HOVER_BORDER = rgba(244, 244, 245, 0.34);
COVER_BG = rgba(255, 255, 255, 0.10);
TEXT = rgba(250, 250, 250, 0.97);
MUTED_TEXT = rgba(212, 212, 216, 0.78);
STATUS_BG = #3a3a3a;
STATUS_BORDER = rgba(244, 244, 245, 0.14);
BADGE_DL_BG = #3c3c3f;
BADGE_DL_TEXT = rgba(226, 232, 240, 0.90);
BADGE_DL_BORDER = rgba(148, 163, 184, 0.30);
BADGE_NEW_BG = rgba(127, 29, 29, 0.50);
BADGE_NEW_TEXT = rgba(254, 202, 202, 0.96);
BADGE_NEW_BORDER = rgba(239, 68, 68, 0.34);
BADGE_OK_BG = rgba(20, 83, 45, 0.50);
BADGE_OK_TEXT = rgba(187, 247, 208, 0.96);
BADGE_OK_BORDER = rgba(34, 197, 94, 0.34);
CARD_SELECTED_BORDER = rgba(147, 197, 253, 0.78);
CARD_SELECTED_BG = rgba(96, 165, 250, 0.22);
CARD_PAUSED_OPACITY = 0.50;
OVERLAY_BTN_BG = rgba(15, 23, 42, 0.28);
OVERLAY_BTN_BG_HOVER = rgba(15, 23, 42, 0.35);
OVERLAY_BTN_BORDER = rgba(255, 255, 255, 0.22);
BTN_DANGER = #E06666;
BTN_DANGER_HOVER = #E57373;
BTN_DANGER_PRESSED = #E89292;
BTN_DANGER_BORDER = #D24F4F;
BTN_DANGER_BORDER_BOTTOM = #B03F3F;
/* @endtokens */

/* @section variant */
/* —— 按钮变种：集中色板 + 属性标记，不限按钮类型与状态 ——
   用法：任意按钮 setProperty("variant", "<name>") 后经 apply_button_variant() 应用本段；
   QToolButton / QPushButton 均已列出，未来 SplitDropButton 等照此追加选择器即可。
   新增变种 = tokens 加一组色（base/hover/pressed/border）+ 本段加三条规则，py 零改动。
   背景：qfluent 仅有 primary（ThemeColor）单变体，本项目在此之上做命名变体扩展。
   为何 widget 级应用而非窗口级 qss：fluent 自带按钮 qss 挂 widget 自身，Qt 层级上
   widget 自身 sheet 绝对压过祖先 sheet（实测 ID+属性 4 段特异性仍输给
   ToggleToolButton:checked 的 2 段），窗口级盖不过；apply_button_variant 走
   setCustomStyleSheet 组合式 API，追加声明置于 fluent 源之后，同特异性后者胜出，
   且随主题切换整体重渲染不丢。 */
QToolButton[variant="danger"]:checked,
QPushButton[variant="danger"]:checked {
    background-color: ${BTN_DANGER};
    border-color: ${BTN_DANGER_BORDER};
    border-bottom-color: ${BTN_DANGER_BORDER_BOTTOM};
    color: white;
}

QToolButton[variant="danger"]:checked:hover,
QPushButton[variant="danger"]:checked:hover {
    background-color: ${BTN_DANGER_HOVER};
    border-color: ${BTN_DANGER_BORDER};
    border-bottom-color: ${BTN_DANGER_BORDER_BOTTOM};
}

QToolButton[variant="danger"]:checked:pressed,
QPushButton[variant="danger"]:checked:pressed {
    background-color: ${BTN_DANGER_PRESSED};
    border-color: ${BTN_DANGER_BORDER};
    border-bottom-color: ${BTN_DANGER_BORDER_BOTTOM};
}
/* @endsection */

/* @section window */
#ToolWorkspaceWindow {
    background: ${CANVAS};
    color: ${TEXT};
}

/* Outer workspace scroll: viewport paints palette Window (dark: 53,53,53 sheet) unless pinned. */
ScrollArea#ToolWorkspaceScroll,
ScrollArea#ToolWorkspaceScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

/* Side rail scrolls itself: keeps the subscribe page minimum small so the window-level
   scrollbar never appears next to the rv table's own edge scrollbar (both sit at x=633..645). */
ScrollArea#SubscribeSideRailScroll,
ScrollArea#SubscribeSideRailScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#SubscribeHeaderShell {
    background: ${SHELL};
    border: 1px solid ${SHELL_BORDER};
    border-radius: 12px;
    min-height: 56px;
}

/* Outer SidePanel: no shell chrome — CardConfFrame / GlobalFrame own the sections. */
QFrame#SubscribeSidePanel {
    background: transparent;
    border: none;
}

/* Two QSS sections inside SidePanel — visually separated, not one flat stack. */
QFrame#SubscribeCardConfFrame {
    background: ${CARD_BG};
    border: 1px solid ${CARD_BORDER};
    border-radius: 10px;
}

QFrame#SubscribeGlobalFrame {
    background: ${STATUS_BG};
    border: 1px solid ${STATUS_BORDER};
    border-radius: 10px;
}

/* Long titles must not wrap/expand CardConf height (breaks side-panel section gap). */
BodyLabel#SubscribeCardConfTitle {
    color: ${TEXT};
    background: transparent;
    max-height: 22px;
}

QFrame#SubscribeSideDivider {
    background: ${SHELL_BORDER};
    border: none;
    max-height: 1px;
    margin: 4px 0;
}

QFrame#SubscribeStatusBar {
    background: ${STATUS_BG};
    border: 1px solid ${STATUS_BORDER};
    border-radius: 10px;
}

QFrame#SubscribeCard {
    background: ${CARD_BG};
    border: 1px solid ${CARD_BORDER};
    border-radius: 12px;
}

QFrame#SubscribeCard:hover {
    border-color: ${CARD_HOVER_BORDER};
}

QFrame#SubscribeCard[selected="true"] {
    background: ${CARD_SELECTED_BG};
    border: 2px solid ${CARD_SELECTED_BORDER};
}

QFrame#SubscribeCard[paused="true"] {
    opacity: ${CARD_PAUSED_OPACITY};
}

QLabel#SubscribeCardCover,
ImageLabel#SubscribeCardCover {
    background: ${COVER_BG};
    border-radius: 9px;
}

QLabel#SubscribeEmptyLabel,
QLabel#SubscribeCardMeta,
QLabel#SubscribeStatusLastRun,
QLabel#SubscribeStatusNextRun,
CaptionLabel {
    color: ${MUTED_TEXT};
    background: transparent;
}

QLabel#SubscribeEmptyLabel {
    padding: 40px 0;
}

StrongBodyLabel,
BodyLabel#SubscribeCardTitle {
    color: ${TEXT};
    background: transparent;
}

QWidget#SubscribeMainPane,
QWidget#SubscribeBody {
    background: transparent;
}

/* Opaque host: solid canvas under waterfall — cuts scroll overdraw vs transparent. */
QWidget#SubscribeCardsHost {
    background: ${CANVAS};
}

ScrollArea#SubscribeScrollArea {
    background: ${CANVAS};
    border: none;
}

ScrollArea#SubscribeScrollArea > QWidget > QWidget {
    background: ${CANVAS};
}

QWidget#SubscribeCardStatusRow {
    background: transparent;
}

QLabel#SubscribeCardBadgeDl {
    background: ${BADGE_DL_BG};
    color: ${BADGE_DL_TEXT};
    border: 1px solid ${BADGE_DL_BORDER};
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#SubscribeCardBadgeLatest {
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#SubscribeCardBadgeLatest[updateState="new"] {
    background: ${BADGE_NEW_BG};
    color: ${BADGE_NEW_TEXT};
    border: 1px solid ${BADGE_NEW_BORDER};
}

QLabel#SubscribeCardBadgeLatest[updateState="ok"] {
    background: ${BADGE_OK_BG};
    color: ${BADGE_OK_TEXT};
    border: 1px solid ${BADGE_OK_BORDER};
}

/* Card cover action chips — objectNames owned by SubscribeCard; no per-widget setStyleSheet. */
QToolButton#SubscribeCardFolderBtn,
QToolButton#SubscribeCardLinkBtn,
QToolButton#SubscribeCardDelBtn {
    background: ${OVERLAY_BTN_BG};
    border: 1px solid ${OVERLAY_BTN_BORDER};
    border-radius: 8px;
    padding: 0px;
}

QToolButton#SubscribeCardFolderBtn:hover,
QToolButton#SubscribeCardLinkBtn:hover,
QToolButton#SubscribeCardDelBtn:hover,
QToolButton#SubscribeCardFolderBtn:pressed,
QToolButton#SubscribeCardLinkBtn:pressed,
QToolButton#SubscribeCardDelBtn:pressed {
    background: ${OVERLAY_BTN_BG_HOVER};
}

/* WebDAV tab — same shell/card/status-bar language as the subscribe sections. */
QFrame#WebdavHeaderShell {
    background: ${SHELL};
    border: 1px solid ${SHELL_BORDER};
    border-radius: 12px;
}

QFrame#WebdavCard {
    background: ${CARD_BG};
    border: 1px solid ${CARD_BORDER};
    border-radius: 10px;
}

QFrame#WebdavActionBar {
    background: ${STATUS_BG};
    border: 1px solid ${STATUS_BORDER};
    border-radius: 10px;
}

/* hitomiTool page — same card language as subscribe/webdav sections. */
QFrame#HitomiFilterCard {
    background: ${CARD_BG};
    border: 1px solid ${CARD_BORDER};
    border-radius: 10px;
}
QFrame#HitomiActionBar {
    background: ${STATUS_BG};
    border: 1px solid ${STATUS_BORDER};
    border-radius: 10px;
}
QFrame#HitomiDivider {
    background: ${SHELL_BORDER};
    border: none;
    max-height: 1px;
}
QLabel#HitomiOutputPath {
    color: ${TEXT};
    background: transparent;
}
QLabel#HitomiOutputCount {
    color: ${MUTED_TEXT};
    background: transparent;
}
QScrollArea#HitomiLetterScroll,
QScrollArea#HitomiLetterScroll > QWidget > QWidget,
QScrollArea#HitomiLangScroll,
QScrollArea#HitomiLangScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

/* addonsInterface page — tool-cell grid; cell proportions locked in code, only placement scales. */
QFrame#AddonsCell {
    background: ${CARD_BG};
    border: 1px solid ${CARD_BORDER};
    border-radius: 10px;
}
QScrollArea#AddonsGridScroll,
QScrollArea#AddonsGridScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}
QFrame#AddonsMgrCell {
    background: transparent;
    border: 1px dashed ${CARD_BORDER};
    border-radius: 10px;
}
/* @endsection */
